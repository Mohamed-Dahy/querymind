# QueryMind environment variables: copy this file to .env and fill in real values.
#   Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Database (Docker Compose, step 0.2) ---
# 127.0.0.1, not localhost: on Windows 'localhost' tries IPv6 first and adds ~2 s per connection
POSTGRES_HOST=127.0.0.1
# 5433 on the host so it doesn't clash with a locally installed Postgres on 5432
POSTGRES_PORT=5433
POSTGRES_DB=northwind
# Superuser for setup/seeding only. The agent never connects with it.
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# --- Read-only role for the agent (step 0.3) ---
ANALYST_RO_USER=analyst_ro
ANALYST_RO_PASSWORD=change-me-readonly

# --- LLM (steps 0.4-0.5) ---
# Which provider the app uses: groq | gemini
# Only the chosen provider's key + model are required.
LLM_PROVIDER=groq

# Groq: keys at https://console.groq.com/keys · models at https://console.groq.com/docs/models
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini: keys at https://aistudio.google.com/apikey · models at https://ai.google.dev/gemini-api/docs/models
GOOGLE_API_KEY=your_google_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional (these are the defaults):
# 0 = most predictable output (best for SQL)
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# --- Query limits (optional: these are the defaults) ---
# Cancel any agent query running longer than this
QUERY_TIMEOUT_SECONDS=10
# Never return more rows than this
MAX_ROWS=1000
# SQL tries per question: when a query fails, the agent sends the error back to the LLM to fix it
MAX_SQL_ATTEMPTS=3

# --- Semantic layer (business definitions shown to the LLM; comma-separated; empty = none) ---
SEMANTIC_LAYER_PATHS=semantic_layer/northwind.yaml,semantic_layer/chinook.yaml

# --- Schema retrieval (optional: these are the defaults) ---
# Send the LLM only the tables a question needs. auto = only above RETRIEVAL_MIN_TABLES tables;
# on = always (error without GOOGLE_API_KEY or the index); off = always the whole schema.
# Uses GOOGLE_API_KEY for embeddings even when LLM_PROVIDER=groq. Build the index first:
#   uv run python scripts/build_index.py
SCHEMA_RETRIEVAL=auto
RETRIEVAL_MIN_TABLES=15
# Tables the search picks; follow-ups, business terms and join paths can add more, up to the max
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TABLES=8
# How tables are ranked: vector (meaning) | keyword (exact words) | hybrid (both, fused by rank)
# | hybrid_rerank (hybrid + one LLM call to reorder: costs ~1.5k tokens per question)
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=gemini-embedding-001

# --- UI (optional: these are the defaults) ---
# Where the Streamlit UI finds the API
API_URL=http://127.0.0.1:8000
# How long the UI waits for one answer (two LLM calls + a query, with retries)
API_TIMEOUT_SECONDS=120
