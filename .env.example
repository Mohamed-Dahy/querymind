# QueryMind environment variables: copy this file to .env and fill in real values.
#   Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Database (Docker Compose, step 0.2) ---
# 127.0.0.1, not localhost: on Windows 'localhost' tries IPv6 first and adds ~2 s per connection
POSTGRES_HOST=127.0.0.1
# 5433 on the host so it doesn't clash with a locally installed Postgres on 5432
POSTGRES_PORT=5433
POSTGRES_DB=northwind
# Superuser for setup/seeding only. The agent never connects with it.
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# --- Read-only role for the agent (step 0.3) ---
ANALYST_RO_USER=analyst_ro
ANALYST_RO_PASSWORD=change-me-readonly

# --- The app's own role: accounts and saved conversations (UI U3.1, logins 5.1) ---
# The API needs it since 5.1 (scripts and evals don't). After setting both:
#   uv run python data/setup_app_db.py
# Must differ from ANALYST_RO_USER and POSTGRES_ADMIN_USER.
APP_DB_USER=qm_app
APP_DB_PASSWORD=change-me-app

# --- Logins (5.1). The API needs APP_DB_USER above and JWT_SECRET; scripts and evals don't. ---
# Signs the login tokens: anyone who has it can log in as anyone. 32+ random characters, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty on purpose: the API refuses to start until you set your own (never reuse an example).
JWT_SECRET=
# Optional (defaults shown):
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=14
# AUTH_COOKIE_PATH=/api/auth     # what the browser sees: the Vite proxy puts the API under /api
# AUTH_COOKIE_SECURE=true        # the cookie only over HTTPS (browsers treat localhost as secure)

# --- Secrets store (5.7): encrypts the LLM keys and database passwords users save. ---
# Anyone with this key and a copy of the database can read every saved key. Make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty on purpose (never reuse an example). To rotate: SECRETS_KEY=<new>,<old>, restart the API,
# run `uv run python scripts/rotate_secrets.py`, then remove <old>. Scripts and evals don't need it.
SECRETS_KEY=

# --- Rate limits (5.6). Optional; defaults shown. Over a limit: HTTP 429 with Retry-After. ---
# RATE_QUESTIONS_PER_MINUTE=10         # per user
# RATE_QUESTIONS_PER_DAY=200           # per user
# RATE_QUESTIONS_TOTAL_PER_DAY=1000    # everyone together (our LLM key; open sign-up)
# RATE_RERUNS_PER_MINUTE=30            # per user
# RATE_LOGINS_PER_IP_PER_MINUTE=10
# RATE_LOGINS_PER_EMAIL_PER_MINUTE=5
# RATE_SIGNUPS_PER_IP_PER_HOUR=5

# --- LLM (steps 0.4-0.5) ---
# Which provider the app uses: groq | gemini
# Only the chosen provider's key + model are required.
LLM_PROVIDER=groq

# Groq: keys at https://console.groq.com/keys · models at https://console.groq.com/docs/models
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini: keys at https://aistudio.google.com/apikey · models at https://ai.google.dev/gemini-api/docs/models
GOOGLE_API_KEY=your_google_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional (these are the defaults):
# 0 = most predictable output (best for SQL)
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# --- Query limits (optional: these are the defaults) ---
# Cancel any agent query running longer than this
QUERY_TIMEOUT_SECONDS=10
# Never return more rows than this
MAX_ROWS=1000
# SQL tries per question: when a query fails, the agent sends the error back to the LLM to fix it
MAX_SQL_ATTEMPTS=3

# --- Evals lab (optional: these are the defaults) ---
# The committed results (uv run python -m evals.snapshot writes them), and BIRD's downloaded
# questions: only they hold BIRD's text, which isn't committed (CC BY-SA). No file = the page says so.
EVALS_SNAPSHOT_PATH=evals/snapshot.json
BIRD_QUESTIONS_PATH=data/raw/bird/mini_dev_postgresql.json

# --- Semantic layer (business definitions shown to the LLM; comma-separated; empty = none) ---
SEMANTIC_LAYER_PATHS=semantic_layer/northwind.yaml,semantic_layer/chinook.yaml

# --- Schema retrieval (optional: these are the defaults) ---
# Send the LLM only the tables a question needs. auto = only above RETRIEVAL_MIN_TABLES tables;
# on = always (error without GOOGLE_API_KEY or the index); off = always the whole schema.
# Uses GOOGLE_API_KEY for embeddings even when LLM_PROVIDER=groq. Build the index first:
#   uv run python scripts/build_index.py
SCHEMA_RETRIEVAL=auto
RETRIEVAL_MIN_TABLES=15
# Tables the search picks; follow-ups, business terms and join paths can add more, up to the max
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TABLES=8
# How tables are ranked: vector (meaning) | keyword (exact words) | hybrid (both, fused by rank)
# | hybrid_rerank (hybrid + one LLM call to reorder: costs ~1.5k tokens per question)
RETRIEVAL_MODE=hybrid
# Few-shot examples: how many verified question -> SQL pairs (semantic_layer/<db>.examples.yaml)
# to show, the closest to the question; 0 = none. They come with schema retrieval (same index):
# with the whole schema (small database, or SCHEMA_RETRIEVAL=off) there are none.
FEW_SHOT_EXAMPLES=3
# Query rewriting: a follow-up is also rewritten into a standalone question (one small LLM call)
# and both are searched. Off: carrying over the previous answer's tables already did the job.
QUERY_REWRITING=false
EMBEDDING_MODEL=gemini-embedding-001
