{
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Continue this conversation (from an earlier reply), so follow-ups like \"now only for 1997\" work. Leave it out to start a new one.",
            "title": "Conversation Id"
          },
          "question": {
            "description": "A question about the data, in plain language",
            "examples": [
              "Which 5 products are the most expensive?"
            ],
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "description": "The answer, plus everything needed to check it: the SQL that ran and its rows.",
        "properties": {
          "answer": {
            "description": "Plain-language answer",
            "title": "Answer",
            "type": "string"
          },
          "answer_from_llm": {
            "description": "False if the LLM's answer was replaced by a safe templated one",
            "title": "Answer From Llm",
            "type": "boolean"
          },
          "attempts": {
            "default": [],
            "description": "The tries before this answer",
            "items": {
              "$ref": "#/components/schemas/FailedAttempt"
            },
            "title": "Attempts",
            "type": "array"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "confidence": {
            "description": "How sure QueryMind is: high, medium or low",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "confidence_reasons": {
            "description": "Why it isn't high (empty when it is)",
            "examples": [
              [
                "It needed 1 repair to get this result."
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Confidence Reasons",
            "type": "array"
          },
          "conversation_id": {
            "description": "Send it with the next question to follow up",
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "How long the whole run took",
            "title": "Duration Ms"
          },
          "example_questions": {
            "default": [],
            "description": "The solved example questions shown to the LLM",
            "items": {
              "type": "string"
            },
            "title": "Example Questions",
            "type": "array"
          },
          "explanation": {
            "description": "What the SQL does, in plain words",
            "title": "Explanation",
            "type": "string"
          },
          "kind": {
            "const": "answer",
            "default": "answer",
            "title": "Kind",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "rows": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          },
          "schema_selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShownSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which tables the LLM was shown"
          },
          "search_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A follow-up as the standalone question that was searched",
            "title": "Search Question"
          },
          "sql": {
            "description": "The validated SQL that actually ran",
            "title": "Sql",
            "type": "string"
          },
          "sql_attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "SQL queries tried, this one too",
            "title": "Sql Attempts"
          },
          "truncated": {
            "description": "True if more rows existed than the row limit",
            "title": "Truncated",
            "type": "boolean"
          },
          "warnings": {
            "default": [],
            "description": "Signs the result may be wrong (empty, duplicated rows...)",
            "items": {
              "$ref": "#/components/schemas/ResultWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "question",
          "conversation_id",
          "answer",
          "answer_from_llm",
          "sql",
          "explanation",
          "columns",
          "rows",
          "row_count",
          "truncated",
          "confidence",
          "confidence_reasons"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "AttemptFailedEvent": {
        "description": "Try number `attempt` failed, or ran but looked wrong (\"suspicious\").",
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "unsafe",
              "db_error",
              "timeout",
              "suspicious"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "attempt_failed",
            "default": "attempt_failed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "attempt",
          "kind",
          "message"
        ],
        "title": "AttemptFailedEvent",
        "type": "object"
      },
      "CheckedEvent": {
        "description": "The result was checked: these are the warning signs (none = it looks fine).",
        "properties": {
          "type": {
            "const": "checked",
            "default": "checked",
            "title": "Type",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/EventWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "warnings"
        ],
        "title": "CheckedEvent",
        "type": "object"
      },
      "ClarificationResponse": {
        "description": "The question had several reasonable meanings: pick one, then ask again.",
        "properties": {
          "clarifying_question": {
            "examples": [
              "How would you define \"best\" customers?"
            ],
            "title": "Clarifying Question",
            "type": "string"
          },
          "conversation_id": {
            "description": "Send it with the next question to follow up",
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "kind": {
            "const": "clarification",
            "default": "clarification",
            "title": "Kind",
            "type": "string"
          },
          "options": {
            "examples": [
              [
                "by total revenue",
                "by number of orders"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Options",
            "type": "array"
          },
          "question": {
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "conversation_id",
          "clarifying_question",
          "options"
        ],
        "title": "ClarificationResponse",
        "type": "object"
      },
      "ErrorEvent": {
        "description": "The last event of a failed run: exactly what `POST /ask` sends with its error status.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Every error has the same shape: a stable code for programs, a message for people.",
        "properties": {
          "error": {
            "description": "Stable error code, e.g. unsafe_sql",
            "examples": [
              "unsafe_sql"
            ],
            "title": "Error",
            "type": "string"
          },
          "message": {
            "examples": [
              "Only SELECT queries are allowed."
            ],
            "title": "Message",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds to wait before retrying (llm_rate_limited, if the provider said)",
            "examples": [
              18
            ],
            "title": "Retry After Seconds"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventWarning": {
        "description": "A sign the result may be wrong: the words for people, not the hint for the LLM.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "EventWarning",
        "type": "object"
      },
      "ExamplesEvent": {
        "description": "The questions of the solved examples shown to the LLM.",
        "properties": {
          "questions": {
            "items": {
              "type": "string"
            },
            "title": "Questions",
            "type": "array"
          },
          "type": {
            "const": "examples",
            "default": "examples",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "questions"
        ],
        "title": "ExamplesEvent",
        "type": "object"
      },
      "FailedAttempt": {
        "description": "A SQL try that failed or looked wrong before the answer. No hint written for the LLM.",
        "properties": {
          "kind": {
            "enum": [
              "unsafe",
              "db_error",
              "timeout",
              "suspicious"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "sql": {
            "title": "Sql",
            "type": "string"
          }
        },
        "required": [
          "sql",
          "kind",
          "message"
        ],
        "title": "FailedAttempt",
        "type": "object"
      },
      "FinalEvent": {
        "description": "The last event of a good run: exactly what `POST /ask` replies.",
        "properties": {
          "reply": {
            "discriminator": {
              "mapping": {
                "answer": "#/components/schemas/AskResponse",
                "clarification": "#/components/schemas/ClarificationResponse",
                "refusal": "#/components/schemas/RefusalResponse"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/AskResponse"
              },
              {
                "$ref": "#/components/schemas/ClarificationResponse"
              },
              {
                "$ref": "#/components/schemas/RefusalResponse"
              }
            ],
            "title": "Reply"
          },
          "type": {
            "const": "final",
            "default": "final",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "reply"
        ],
        "title": "FinalEvent",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "RefusalResponse": {
        "description": "QueryMind won't do this (e.g. change data). Nothing in the database was changed.",
        "properties": {
          "conversation_id": {
            "description": "Send it with the next question to follow up",
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "kind": {
            "const": "refusal",
            "default": "refusal",
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "examples": [
              "I can only read data, not change it."
            ],
            "title": "Message",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "conversation_id",
          "message"
        ],
        "title": "RefusalResponse",
        "type": "object"
      },
      "ResultWarning": {
        "description": "A sign that the result may be wrong although the query ran (see agent/sanity.py).",
        "properties": {
          "code": {
            "examples": [
              "duplicate_rows"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "examples": [
              "Some rows appear more than once, which can mean a join counted things twice."
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ResultWarning",
        "type": "object"
      },
      "RewriteEvent": {
        "description": "A follow-up was searched as this standalone question.",
        "properties": {
          "search_question": {
            "title": "Search Question",
            "type": "string"
          },
          "type": {
            "const": "rewrite",
            "default": "rewrite",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "search_question"
        ],
        "title": "RewriteEvent",
        "type": "object"
      },
      "SchemaEvent": {
        "description": "Which tables the LLM was shown.",
        "properties": {
          "schema_selection": {
            "$ref": "#/components/schemas/ShownSchema"
          },
          "type": {
            "const": "schema",
            "default": "schema",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "schema_selection"
        ],
        "title": "SchemaEvent",
        "type": "object"
      },
      "ShownSchema": {
        "description": "Which tables the LLM saw, for people. SchemaSelection's raw fallback `reason` stays out.",
        "properties": {
          "mode": {
            "enum": [
              "full",
              "retrieved",
              "fallback"
            ],
            "title": "Mode",
            "type": "string"
          },
          "search": {
            "default": "",
            "title": "Search",
            "type": "string"
          },
          "tables": {
            "items": {
              "type": "string"
            },
            "title": "Tables",
            "type": "array"
          },
          "total_tables": {
            "title": "Total Tables",
            "type": "integer"
          }
        },
        "required": [
          "mode",
          "tables",
          "total_tables"
        ],
        "title": "ShownSchema",
        "type": "object"
      },
      "SqlEvent": {
        "description": "Try number `attempt`: the LLM's SQL, not validated yet.",
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "sql": {
            "title": "Sql",
            "type": "string"
          },
          "type": {
            "const": "sql",
            "default": "sql",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "attempt",
          "sql",
          "explanation"
        ],
        "title": "SqlEvent",
        "type": "object"
      },
      "StepEvent": {
        "description": "A node of the graph started, finished or failed. `duration_ms` is set when it ended.",
        "properties": {
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "node": {
            "enum": [
              "retrieve_schema",
              "generate_sql",
              "run_sql",
              "check_result",
              "repair_sql",
              "summarize"
            ],
            "title": "Node",
            "type": "string"
          },
          "status": {
            "enum": [
              "started",
              "finished",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "const": "step",
            "default": "step",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "node",
          "status"
        ],
        "title": "StepEvent",
        "type": "object"
      },
      "ValidatedEvent": {
        "description": "Try number `attempt` passed the SQL validator and is about to run.",
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "type": {
            "const": "validated",
            "default": "validated",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "attempt"
        ],
        "title": "ValidatedEvent",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Ask questions about your company database in plain language.",
    "title": "QueryMind",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ask": {
      "post": {
        "description": "Answer a question about the data: the answer, the SQL that ran, and the rows.\n\nOr, with `kind` = \"clarification\", a question back with options (the question was\nambiguous), or with `kind` = \"refusal\", why QueryMind won't do it (e.g. change data).\n\nEvery reply has a `conversation_id`: send it with the next question to follow up on this\none (\"now only for 1997\"). Without one, a new conversation starts.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "answer": "#/components/schemas/AskResponse",
                      "clarification": "#/components/schemas/ClarificationResponse",
                      "refusal": "#/components/schemas/RefusalResponse"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AskResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ClarificationResponse"
                    },
                    {
                      "$ref": "#/components/schemas/RefusalResponse"
                    }
                  ],
                  "title": "Response Ask Ask Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid question, or unsafe generated SQL"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The LLM provider's usage limit was reached"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The LLM or the database failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database is not reachable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The query took too long"
          }
        },
        "summary": "Ask",
        "tags": [
          "questions"
        ]
      }
    },
    "/ask/stream": {
      "post": {
        "description": "The same as `POST /ask`, reporting each step as it happens (Server-Sent Events).\n\nEach event is one JSON object with a `type`. The last is `final` (the `POST /ask` reply) or\n`error` (its error body): the status is already sent, so a failed run still answers 200.\n\nClosing the connection stops the run after the step working now.",
        "operationId": "ask_stream_ask_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "discriminator": {
                          "mapping": {
                            "attempt_failed": "#/components/schemas/AttemptFailedEvent",
                            "checked": "#/components/schemas/CheckedEvent",
                            "error": "#/components/schemas/ErrorEvent",
                            "examples": "#/components/schemas/ExamplesEvent",
                            "final": "#/components/schemas/FinalEvent",
                            "rewrite": "#/components/schemas/RewriteEvent",
                            "schema": "#/components/schemas/SchemaEvent",
                            "sql": "#/components/schemas/SqlEvent",
                            "step": "#/components/schemas/StepEvent",
                            "validated": "#/components/schemas/ValidatedEvent"
                          },
                          "propertyName": "type"
                        },
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/StepEvent"
                          },
                          {
                            "$ref": "#/components/schemas/SchemaEvent"
                          },
                          {
                            "$ref": "#/components/schemas/RewriteEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ExamplesEvent"
                          },
                          {
                            "$ref": "#/components/schemas/SqlEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ValidatedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/AttemptFailedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/CheckedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/FinalEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ErrorEvent"
                          }
                        ],
                        "title": "Streamitem Ask Stream Ask Stream Post"
                      },
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid question"
          }
        },
        "summary": "Ask Stream",
        "tags": [
          "questions"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness check: the server is up. It doesn't touch the DB or LLM (see DEV_GUIDE).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
